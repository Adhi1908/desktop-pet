{
  "name": "desktop-pet",
  "productName": "Desktop Pet",
  "version": "1.1.0",
  "description": "A small pet that lives on top of your taskbar and reacts to your typing.",
  "author": {
    "name": "Adhi1908",
    "url": "https://github.com/Adhi1908"
  },
  "license": "MIT",
  "homepage": "https://github.com/Adhi1908/desktop-pet",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adhi1908/desktop-pet.git"
  },
  "bugs": "https://github.com/Adhi1908/desktop-pet/issues",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sprites": "node scripts/generate-placeholder-sprites.js",
    "prestart": "node scripts/generate-placeholder-sprites.js --quiet",
    "start": "electron .",
    "prebuild": "node scripts/generate-placeholder-sprites.js --quiet",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "koffi": "2.16.3",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.desktoppet.app",
    "productName": "Desktop Pet",
    "copyright": "Copyright © 2026 Adhi1908",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings-preload.js",
      "lib/**/*",
      "config.json",
      "renderer/**/*",
      "assets/**/*",
      "!node_modules/koffi/{doc,src,vendor}/**"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/koffi/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "files": [
        "!node_modules/koffi/build/koffi/!(win32_x64)/**",
        "!node_modules/uiohook-napi/prebuilds/!(win32-x64)/**"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "files": [
        "!node_modules/koffi/build/koffi/!(darwin_arm64|darwin_x64)/**",
        "!node_modules/uiohook-napi/prebuilds/!(darwin-arm64|darwin-x64)/**"
      ]
    },
    "dmg": {
      "artifactName": "Desktop-Pet-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "packElevateHelper": false,
      "artifactName": "Desktop-Pet-Setup-${version}.${ext}"
    }
  }
}
