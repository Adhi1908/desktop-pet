      "sit":         { "row": 3,  "frames": 4, "fps": 4,  "hatAnchor": { "x": 19, "y": 8 } },
      "sleep":       { "row": 4,  "frames": 2, "fps": 2,  "hatAnchor": { "x": 23, "y": 21 } },
      "excited":     { "row": 5,  "frames": 4, "fps": 12, "hatAnchor": { "x": 22, "y": 6 } },
      "dragged":     { "row": 6,  "frames": 4, "fps": 8,  "hatAnchor": { "x": 22, "y": 5 } },
      "fall":        { "row": 7,  "frames": 2, "fps": 8,  "hatAnchor": { "x": 22, "y": 6 } },
      "trick_spin":  { "row": 8,  "frames": 6, "fps": 12 },
